using Gtk 4.0;
using Adw 1;

Adw.ToolbarView toolbar {
  [top]
  Adw.HeaderBar header_bar {
    decoration-layout: ":minimize,close";

    [start]
    Button back_button {
      icon-name: "go-previous-symbolic";
      tooltip-text: _("Back");
      visible: false;
    }

    [title]
    Label {
      label: _("Debby");
    }

    [end]
    MenuButton menu_button {
      icon-name: "open-menu-symbolic";
      tooltip-text: _("Main Menu");
      menu-model: app_menu;
    }
  }

  content: Overlay {
    Stack main_stack {
      transition-type: crossfade;

      Gtk.StackPage {
        name: "package";

        child: Adw.Clamp package_page {
          margin-top: 24;
          margin-bottom: 24;
          margin-start: 16;
          margin-end: 16;

          child: Box list_box {
            orientation: vertical;
            spacing: 20;

            Adw.StatusPage empty_page {
              icon-name: "com.cobisimo.Debby";
              title: _("Install a Debian package");
              description: _("Choose a .deb package to view its details and install it.");

              Button select_button {
                styles [
                  "suggested-action",
                  "pill",
                  "package-action",
                ]

                accessibility {
                  label: _("Choose Package…");
                }

                child: Box {
                  spacing: 6;
                  halign: center;

                  Image {
                    icon-name: "document-open-symbolic";
                    pixel-size: 24;
                    accessible-role: presentation;
                  }

                  Label {
                    label: _("Choose Package…");
                  }
                };
              }
            }

            Box package_details {
              orientation: vertical;
              spacing: 20;
              visible: false;

              Image package_icon {
                icon-name: "package-x-generic";
                pixel-size: 128;
                halign: center;
                accessible-role: presentation;
              }

              Label package_name {
                label: "";
                halign: center;
                wrap: true;
                wrap-mode: word_char;
                justify: center;

                styles [
                  "title-2",
                ]
              }

              StackSwitcher {
                halign: center;
                stack: package_stack;
              }

              Stack package_stack {
                transition-type: crossfade;
                vexpand: true;
                vhomogeneous: false;

                Gtk.StackPage {
                  name: "information";
                  title: _("Information");

                  child: ScrolledWindow {
                    vexpand: true;
                    hscrollbar-policy: never;
                    min-content-height: 120;
                    propagate-natural-height: false;
                    propagate-natural-width: false;

                    child: Box {
                      orientation: vertical;
                      spacing: 20;

                      Adw.PreferencesGroup info_group {
                        visible: false;

                        Adw.ActionRow package_version_row {
                          title: _("Package version");
                          subtitle: "-";

                          styles [
                            "package-version",
                          ]
                        }

                        Adw.ActionRow installed_size_row {
                          title: _("Installed size");
                          subtitle: "-";
                        }

                        Adw.ActionRow desc_row {
                          title: _("Description");
                          subtitle: "-";
                        }
                      }
                    };
                  };
                }

                Gtk.StackPage {
                  name: "dependencies";
                  title: _("Dependencies");

                  child: ScrolledWindow {
                    vexpand: true;
                    hscrollbar-policy: never;
                    min-content-height: 120;
                    propagate-natural-height: false;
                    propagate-natural-width: false;

                    child: Adw.PreferencesGroup dependencies_group {
                      ListBox dependency_rows {
                        selection-mode: none;

                        styles [
                          "boxed-list",
                        ]
                      }
                    };
                  };
                }
              }
            }
          };
        };
      }

      Gtk.StackPage {
        name: "progress";

        child: Box progress_page {
          orientation: vertical;
          valign: center;
          spacing: 12;
          margin-start: 24;
          margin-end: 24;

          Box progress_box {
            orientation: vertical;
            spacing: 12;
            halign: center;

            Image progress_icon {
              icon-name: "emblem-ok-symbolic";
              pixel-size: 48;
              halign: center;
              visible: false;

              styles [
                "success-icon",
              ]

              accessibility {
                label: _("Complete");
              }
            }

            Label progress_label {
              label: "";

              styles [
                "title-3",
              ]
            }

            ProgressBar progress_bar {
              show-text: true;
              width-request: 320;
              margin-top: 16;
            }
          }

          Label progress_error {
            label: "";
            wrap: true;
            justify: center;
            selectable: true;
            visible: false;
          }
        };
      }
    }

    [overlay]
    ScrolledWindow console_scroll {
      halign: fill;
      valign: end;
      height-request: 220;
      margin-top: 16;
      margin-bottom: 16;
      margin-start: 16;
      margin-end: 16;
      visible: false;

      styles [
        "terminal-overlay",
      ]

      TextView console {
        editable: false;
        monospace: true;
        wrap-mode: word_char;

        styles [
          "terminal-overlay-text",
        ]
      }
    }
  };

  [bottom]
  Adw.Bin footer {
    margin-start: 12;
    margin-end: 12;
    margin-top: 12;
    margin-bottom: 12;

    child: CenterBox {
      [center]
      Box {
        halign: center;

        Box controls_box {
          orientation: horizontal;
          spacing: 12;
          halign: center;
          visible: false;

          Button package_launch_button {
            accessibility {
              label: _("Run");
            }

            child: Image {
              icon-name: "media-playback-start-symbolic";
              pixel-size: 24;
              accessible-role: presentation;
            };

            tooltip-text: _("Run");
            halign: center;
            valign: center;
            visible: false;

            styles [
              "success-action",
              "circular",
              "icon-action",
            ]
          }

          Button install_button {
            accessibility {
              label: _("Install");
            }

            child: Box {
              spacing: 6;
              halign: center;

              Image {
                icon-name: "system-software-install-symbolic";
                pixel-size: 24;
                accessible-role: presentation;
              }

              Label install_label {
                label: _("Install");
              }
            };

            tooltip-text: _("Install");
            sensitive: false;

            styles [
              "suggested-action",
              "pill",
              "package-action",
            ]
          }

          Button uninstall_button {
            accessibility {
              label: _("Uninstall");
            }

            child: Image {
              icon-name: "user-trash-symbolic";
              pixel-size: 24;
              accessible-role: presentation;
            };

            tooltip-text: _("Uninstall");
            halign: center;
            valign: center;

            styles [
              "destructive-action",
              "circular",
              "icon-action",
            ]

            visible: false;
          }
        }

        Button launch_button {
          accessibility {
            label: _("Run");
          }

          child: Box {
            spacing: 6;
            halign: center;

            Image {
              icon-name: "media-playback-start-symbolic";
              pixel-size: 24;
              accessible-role: presentation;
            }

            Label {
              label: _("Run");
            }
          };

          tooltip-text: _("Run");
          halign: center;
          valign: center;
          visible: false;

          styles [
            "success-action",
            "pill",
            "package-action",
          ]
        }
      }

      [end]
      ToggleButton advanced_check {
        halign: end;
        valign: center;
        icon-name: "utilities-terminal-symbolic";
        tooltip-text: _("Details");

        styles [
          "flat",
        ]

        accessibility {
          label: _("Details");
        }
      }
    };
  }
}

menu app_menu {
  item {
    label: _("Choose Package…");
    action: "win.open";
  }

  section package_menu {
    item {
      label: _("Run");
      action: "win.launch";
    }

    item {
      label: _("Install");
      action: "win.install";
    }

    item {
      label: _("Uninstall");
      action: "win.uninstall";
    }
  }

  section {
    item {
      label: _("Back");
      action: "win.back";
    }

    item {
      label: _("Details");
      action: "win.details";
    }
  }

  item {
    label: _("About Debby");
    action: "win.about";
  }
}

Adw.ActionRow file_row {
  title: _("Choose a .deb package");
  subtitle: _("No package selected");
}
