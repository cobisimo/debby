msgstr "pkexec शुरू नहीं किया जा सका।"

#: src/operations.rs:91
msgid "Authorization was cancelled or the process failed."
msgstr "प्राधिकरण रद्द कर दिया गया या प्रक्रिया विफल रही।"

#: src/package.rs:112 src/package.rs:117 src/package.rs:121
msgid "Install"
msgstr "इंस्टॉल करें"

#: src/package.rs:130
msgid "Upgrade"
msgstr "अपग्रेड करें"

#: src/package.rs:132
msgid "Reinstall"
msgstr "फिर से इंस्टॉल करें"

#: src/ui/actions.rs:23
