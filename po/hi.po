#: src/dependencies.rs:219
msgid "Checking dependencies…"
msgstr "निर्भरताएँ जाँची जा रही हैं…"

#: src/dependencies.rs:235 src/dependencies.rs:268
msgid "Dependency information unavailable"
msgstr "निर्भरताओं की जानकारी उपलब्ध नहीं है"

#: src/dependencies.rs:244
msgid "No declared dependencies."
msgstr "कोई घोषित निर्भरता नहीं है।"

#: src/dependencies.rs:261
msgid "Declared dependency (not an installed-status check)"
msgstr "घोषित निर्भरता (इंस्टॉल होने की स्थिति की जाँच नहीं)"

#: src/dependencies.rs:263 src/dependencies.rs:276
msgid "Will be installed"
msgstr "इंस्टॉल किया जाएगा"

#: src/dependencies.rs:273
